  "authors": [
    "borispaskov228-cloud"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.magicalmod.MagicalMod"
    ],
    "client": [
      "com.magicalmod.client.MagicalModClient"
    ]
  },
  "mixins": [
    "magicalmod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
